PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/academyflow
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG
ALLOWED_ORIGINS=http://localhost:3000

# First Super Admin
SUPERADMIN_NAME=AcademyFlow Owner
SUPERADMIN_USERNAME=academyflow_admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!

# Zoom User-managed OAuth (General App)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://academyflow.up.railway.app/api/zoom/callback
# Optional but recommended. If blank, JWT_SECRET is used as the encryption source.
ZOOM_TOKEN_ENCRYPTION_KEY=

# Zoom Event Subscription secret token
ZOOM_WEBHOOK_SECRET_TOKEN=

# Public URL used in email links
PUBLIC_URL=https://your-domain.example

# SendGrid Email API (HTTPS)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
SENDGRID_FROM_NAME=AcademyFlow
# Optional. Defaults to SENDGRID_FROM_EMAIL.
SENDGRID_REPLY_TO=

# AcademyFlow AI (server-side only)
# Free-first default: Gemini 3.5 Flash-Lite
ACADEMYFLOW_AI_ENABLED=true
ACADEMYFLOW_AI_PROVIDER=gemini
GEMINI_API_KEY=
ACADEMYFLOW_AI_MODEL=gemini-3.5-flash-lite
ACADEMYFLOW_AI_RATE_LIMIT=30
ACADEMYFLOW_AI_TIMEOUT_MS=30000
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional future provider switch
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Backups
# Backup payloads are encrypted and stored in MongoDB GridFS.
# No persistent filesystem or Railway Volume is required.
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=5
# Production restore is intentionally disabled unless this is set to true.
# Enable only for a controlled restore window, then disable it again.
ENABLE_PRODUCTION_RESTORE=false

# Monitoring and alerts
MONITORING_ENABLED=true
MONITOR_INTERVAL_MINUTES=15
ALERT_COOLDOWN_MINUTES=360
# Optional. Defaults to SUPERADMIN_EMAIL.
ALERT_EMAIL=
BACKUP_STALE_HOURS=30
DB_PING_ALERT_MS=1000
ERROR_ALERT_WINDOW_MINUTES=15
ERROR_ALERT_THRESHOLD=5
STORAGE_FREE_PERCENT_ALERT=15

# File storage
# Certificate PDFs are stored in MongoDB GridFS.
# No CERTIFICATE_STORAGE_DIR or external object-storage variables are required.
