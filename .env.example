PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/academyflow
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG
ALLOWED_ORIGINS=http://localhost:3000

# First Super Admin
# Login is by username + password.
# The account is created automatically on startup if it does not exist.
# Existing Super Admin passwords are NEVER overwritten automatically.
SUPERADMIN_NAME=AcademyFlow Owner
SUPERADMIN_USERNAME=academyflow_admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
# Zoom Event Subscription secret token (for verified attendance)
ZOOM_WEBHOOK_SECRET_TOKEN=
